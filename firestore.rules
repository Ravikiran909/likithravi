rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "kiranmravi45@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidUser(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && (!('accountType' in data) || (data.accountType in ['student', 'user']))
        && (!('role' in data) || (data.role in ['student', 'user', 'admin']));
    }

    function isValidStudentProfile(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('accountType' in data) || (data.accountType in ['student', 'user']))
        && (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 20));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role in ['student', 'user'] || isAdmin());
      allow update: if (isOwner(userId) && isValidUser(request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role in ['student', 'user'] || request.resource.data.role == resource.data.role))
        || (isAdmin() && isValidUser(request.resource.data));
      allow delete: if isAdmin();
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidStudentProfile(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidStudentProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    // RAG Documents Collection
    match /documents/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Messages Collection
    match /messages/{messageId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn() && (request.query.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Quizzes Collection
    match /quizzes/{quizId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn() && (request.query.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Study Plans Collection
    match /study_plans/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Reminders Collection
    match /reminders/{reminderId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn() && (request.query.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Focus Sessions Collection
    match /focus_sessions/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Learning Objectives Collection
    match /learning_objectives/{objId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Material Reviews Collection
    match /material_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Mock Interviews Collection
    match /mock_interviews/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Peer Study Rooms Collection
    match /peer_study_rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    function isValidResume(data) {
      return data.userId is string && data.userId.size() <= 128
        && (!('template' in data) || (data.template is string && data.template.size() <= 50));
    }

    function isValidAIChatMessage(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.role in ['user', 'model']
        && data.content is string && data.content.size() <= 5000;
    }

    // Resumes Collection
    match /resumes/{resumeId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn() && (request.query.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidResume(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isValidResume(request.resource.data);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // AIO Chats Collection
    match /aio_chats/{messageId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn() && (request.query.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAIChatMessage(request.resource.data);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // System Telemetry Collection
    match /system_telemetry/{docId} {
      allow read, write: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}

