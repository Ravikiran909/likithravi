rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "kiranmravi45@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.role in ['student', 'admin'];
    }

    function isValidStudentProfile(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.preferredLanguage is string && data.preferredLanguage.size() <= 20;
    }

    function isValidDocumentRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.subject is string && data.subject.size() <= 100;
    }

    function isValidLearningObjective(data) {
      return data.id is string && data.id.size() <= 128
        && data.subject is string && data.subject.size() <= 100
        && data.title is string && data.title.size() <= 200;
    }

    function isValidMessage(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.direction in ['incoming', 'outgoing']
        && data.content is string && data.content.size() <= 5000;
    }

    function isValidQuiz(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.subject is string && data.subject.size() <= 100
        && data.score is number && data.totalQuestions is number;
    }

    function isValidStudyPlan(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.subject is string && data.subject.size() <= 100
        && data.status in ['active', 'completed', 'paused'];
    }

    function isValidReminder(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.reminderText is string && data.reminderText.size() <= 500;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(userId) && isValidStudentProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    // RAG Documents Collection
    match /documents/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(docId) && isValidDocumentRecord(request.resource.data);
      allow delete: if true;
    }

    // Messages Collection
    match /messages/{messageId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidId(messageId) && isValidMessage(request.resource.data);
      allow delete: if isAdmin();
    }

    // Quizzes Collection
    match /quizzes/{quizId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(quizId) && isValidQuiz(request.resource.data);
      allow delete: if isAdmin();
    }

    // Study Plans Collection
    match /study_plans/{userId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(userId) && isValidStudyPlan(request.resource.data);
      allow delete: if isAdmin();
    }

    // Reminders Collection
    match /reminders/{reminderId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(reminderId) && isValidReminder(request.resource.data);
      allow delete: if true;
    }

    // Focus Sessions Collection
    match /focus_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Learning Objectives Collection
    match /learning_objectives/{objId} {
      allow get, list: if true;
      allow create, update: if isValidId(objId) && isValidLearningObjective(request.resource.data);
      allow delete: if true;
    }

    // Material Reviews Collection
    match /material_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // System Telemetry Collection
    match /system_telemetry/{docId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
