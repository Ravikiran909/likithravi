{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user account with role",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student academic preferences, streak, and progress metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi", "kn"] },
        "educationLevel": { "type": "string", "maxLength": 50 },
        "currentSkillLevel": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "expert"] },
        "studyHoursPerDay": { "type": "number" },
        "weeklyStudyHoursGoal": { "type": "number" },
        "weeklyHoursCompleted": { "type": "number" },
        "preferredStudyTime": { "type": "string", "maxLength": 30 },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "fcmPushEnabled": { "type": "boolean" },
        "deepFocusEnabled": { "type": "boolean" },
        "dailyReminderEnabled": { "type": "boolean" },
        "streak": { "type": "number" },
        "overallProgress": { "type": "number" },
        "totalQuestionsAnswered": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 30 },
        "earnedBadges": { "type": "array", "description": "Awarded learning achievement badges stored in the user profile document" },
        "achievements": { "type": "array", "description": "List of unlocked achievement badge IDs" },
        "dailyMicroGoals": { "type": "array", "description": "Student daily micro-goals with progress counts and target counts" },
        "placementPrep": { "type": "object", "description": "Campus and off-campus placement preparation tracker for Indian recruiters" },
        "mockInterviewHistory": { "type": "array", "description": "Completed company-specific technical mock interview sessions and scores" },
        "joinedPeerRoomIds": { "type": "array", "description": "IDs of virtual peer study rooms joined by the student" }
      },
      "required": ["userId", "name", "whatsappNumber", "preferredLanguage"]
    },
    "MockInterviewSession": {
      "title": "MockInterviewSession",
      "description": "Company-specific technical mock interview role-play session with per-response feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "companyId": { "type": "string", "maxLength": 64 },
        "companyName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 },
        "roundType": { "type": "string", "maxLength": 80 },
        "overallScore": { "type": "number" },
        "completedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "companyId", "companyName", "overallScore"]
    },
    "PeerStudyRoom": {
      "title": "PeerStudyRoom",
      "description": "Virtual peer study group room matched by subject and skill level with shared docs and voice chat",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "subject": { "type": "string", "maxLength": 100 },
        "skillLevel": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "expert"] },
        "topic": { "type": "string", "maxLength": 150 },
        "sharedNoteContent": { "type": "string", "maxLength": 5000 },
        "activeVoiceCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "subject", "skillLevel"]
    },
    "MessageRecord": {
      "title": "MessageRecord",
      "description": "Chat log between student and WhatsApp learning agents",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "direction": { "type": "string", "enum": ["incoming", "outgoing"] },
        "messageType": { "type": "string", "enum": ["text", "image", "audio", "interactive", "document"] },
        "content": { "type": "string", "maxLength": 5000 },
        "intent": { "type": "string", "maxLength": 50 },
        "agentName": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "direction", "content", "timestamp"]
    },
    "QuizSession": {
      "title": "QuizSession",
      "description": "Active or past quiz session history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 100 },
        "difficulty": { "type": "string", "maxLength": 30 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "completed": { "type": "boolean" },
        "startedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "subject", "topic", "score", "totalQuestions"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "Personalized study timetable and milestones",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 100 },
        "targetExam": { "type": "string", "maxLength": 150 },
        "examDate": { "type": "string", "maxLength": 30 },
        "dailyHours": { "type": "number" },
        "totalDays": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "paused"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "subject", "dailyHours", "totalDays", "status"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "WhatsApp learning study nudge reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "reminderText": { "type": "string", "maxLength": 500 },
        "targetTime": { "type": "string", "maxLength": 30 },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "once"] },
        "subject": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "reminderText", "targetTime", "status"]
    },
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "Indexed RAG knowledge base study document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "originalFilename": { "type": "string", "maxLength": 200 },
        "fileSizeKb": { "type": "number" },
        "uploadedAt": { "type": "string", "maxLength": 50 },
        "chunkCount": { "type": "number" },
        "summary": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "title", "subject"]
    },
    "LearningObjective": {
      "title": "LearningObjective",
      "description": "Curriculum learning objective imported via CSV or admin dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "targetLevel": { "type": "string", "maxLength": 50 },
        "bloomLevel": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "subject", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role"
    },
    "/profiles/{userId}": {
      "schema": "StudentProfile",
      "description": "Academic progress and settings for each student"
    },
    "/messages/{messageId}": {
      "schema": "MessageRecord",
      "description": "Chat transcript messages"
    },
    "/quizzes/{quizId}": {
      "schema": "QuizSession",
      "description": "Individual quiz attempts and outcomes"
    },
    "/study_plans/{userId}": {
      "schema": "StudyPlan",
      "description": "Student tailored study timetable"
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Student study reminders"
    },
    "/documents/{docId}": {
      "schema": "DocumentRecord",
      "description": "RAG curriculum knowledge base documents"
    },
    "/learning_objectives/{objId}": {
      "schema": "LearningObjective",
      "description": "Curriculum learning objectives"
    },
    "/mock_interviews/{sessionId}": {
      "schema": "MockInterviewSession",
      "description": "Company-specific technical mock interview role-play sessions"
    },
    "/peer_study_rooms/{roomId}": {
      "schema": "PeerStudyRoom",
      "description": "Virtual peer study group rooms with shared documents and voice chat state"
    }
  }
}
