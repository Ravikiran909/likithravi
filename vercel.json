{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/webhook/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|webhook).*)",
      "destination": "/index.html"
    }
  ]
}
